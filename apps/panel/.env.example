# ---------------------------------------------------------------------------
# Atlas Panel — local development example
# ---------------------------------------------------------------------------
# Copy to .env, then:
#   php artisan key:generate
#   touch database/database.sqlite
#   php artisan migrate:fresh --seed
#   php artisan serve --port=8015
#
# This file is for a workstation. The template an install on a real server uses
# is .env.production.example — the installer writes its own copy of that.
#
# There is no npm step anywhere: CSS and JS are served from public/assets.

APP_NAME="Atlas Panel"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8015
APP_TIMEZONE=UTC

LOG_CHANNEL=stack
LOG_LEVEL=debug

# SQLite for development so nothing else has to be installed first.
DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=atlas_panel
# DB_USERNAME=atlas_panel
# DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
# Over plain http on 127.0.0.1 this must be false, or the browser drops the
# session cookie and every login appears to fail.
SESSION_SECURE_COOKIE=false
SESSION_ENCRYPT=false

CACHE_STORE=file
QUEUE_CONNECTION=sync
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# Mail: the module and the transport are separate concerns. The panel's mail
# module (mailboxes, webmail) is off here; MAIL_* only affects panel-generated
# messages such as password resets.
MAIL_MAILER=log
MAIL_FROM_ADDRESS="panel@atlas.test"
MAIL_FROM_NAME="${APP_NAME}"

# ---- Atlas ----------------------------------------------------------------
APP_VERSION=0.9.0

# sandbox = no root, no changes to the machine (what a workstation should use)
# socket  = the real privileged agent over /run/atlas/agent.sock
ATLAS_AGENT_DRIVER=sandbox
ATLAS_AGENT_SOCKET=/run/atlas/agent.sock
ATLAS_AGENT_KEY=/etc/atlas/agent.secret
ATLAS_AGENT_TIMEOUT=30

ATLAS_CENTRAL_URL=https://api.atlas.example
ATLAS_LICENSE_GRACE_DAYS=14

# Illustrative defaults — every port is configurable and the installer writes
# whatever the operator chose.
ATLAS_WHM_PORT=2087
ATLAS_PANEL_PORT=2083
ATLAS_WEBMAIL_PORT=2096

# Optional modules. Mail needs Postfix + Dovecot; DNS needs PowerDNS.
ATLAS_MAIL_ENABLED=true
ATLAS_IMAP_HOST=127.0.0.1
ATLAS_IMAP_PORT=993
ATLAS_SMTP_HOST=127.0.0.1
ATLAS_SMTP_PORT=587

ATLAS_DNS_ENABLED=true
ATLAS_NAMESERVERS=ns1.example.com,ns2.example.com

ATLAS_BACKUP_DIR=/var/backups/atlas
ATLAS_HOME_ROOT=/home

# PHP-FPM minors this server runs. The WHM service screen offers a restart
# button for exactly these; a mismatch produces no button rather than a button
# that fails.
ATLAS_PHP_VERSIONS=8.3
ATLAS_PHP_DEFAULT=8.3
