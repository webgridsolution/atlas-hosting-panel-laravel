# Atlas customer panel ({{PANEL_PORT}}) and webmail ({{WEBMAIL_PORT}}) — template.
#
# Both are the same application: the panel routes decide what a customer sees.
# Webmail is a separate server block only so it can live on its own port and, if
# an operator prefers, its own hostname.

server {
    listen {{PANEL_PORT}} ssl http2;
    listen [::]:{{PANEL_PORT}} ssl http2;
    server_name _;

    ssl_certificate     /etc/atlas/tls/bootstrap.crt;
    ssl_certificate_key /etc/atlas/tls/bootstrap.key;
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_session_cache   shared:AtlasPanel:10m;

    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-Content-Type-Options "nosniff" always;

    client_max_body_size 32m;

    root /opt/atlas/current/public;
    index index.php;

    location / {
        try_files $uri $uri/ /index.php?$query_string;
    }

    location ~ \.php$ {
        include snippets/fastcgi-php.conf;
        fastcgi_pass unix:/run/php/atlas-panel.sock;
        fastcgi_read_timeout 120s;
    }

    location ~ /\.(?!well-known) {
        deny all;
    }

    access_log /var/log/atlas/panel.access.log;
    error_log  /var/log/atlas/panel.error.log;
}

server {
    listen {{WEBMAIL_PORT}} ssl http2;
    listen [::]:{{WEBMAIL_PORT}} ssl http2;
    server_name _;

    ssl_certificate     /etc/atlas/tls/bootstrap.crt;
    ssl_certificate_key /etc/atlas/tls/bootstrap.key;
    ssl_protocols       TLSv1.2 TLSv1.3;

    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header X-Frame-Options "SAMEORIGIN" always;

    client_max_body_size 16m;

    root /opt/atlas/current/public;
    index index.php;

    # Only the webmail area is reachable on this port; everything else is a
    # 404 rather than a redirect, so the port advertises nothing else.
    location / {
        return 404;
    }

    location ~ ^/webmail {
        try_files $uri $uri/ /index.php?$query_string;
    }

    location ~ \.php$ {
        include snippets/fastcgi-php.conf;
        fastcgi_pass unix:/run/php/atlas-panel.sock;
    }

    access_log /var/log/atlas/webmail.access.log;
    error_log  /var/log/atlas/webmail.error.log;
}
