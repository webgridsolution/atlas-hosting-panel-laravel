# ---------------------------------------------------------------------------
# Atlas Panel — production template for a server install
# ---------------------------------------------------------------------------
# The installer writes this file for you (deploy/install.sh → atlas-install).
# Copy it by hand only when you know what you are doing.
#
# Secrets are generated, never defaulted: `php artisan key:generate` and the
# installer both refuse to leave APP_KEY empty.

APP_NAME="Atlas Panel"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://panel.example.com
APP_TIMEZONE=UTC

LOG_CHANNEL=daily
LOG_LEVEL=warning

# MySQL 8.4 is the production database; the panel creates its own schema.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=atlas_panel
DB_USERNAME=atlas_panel
DB_PASSWORD=

# Sessions and cache live on disk so a Redis outage cannot lock operators out
# of the panel they need to fix it with.
SESSION_DRIVER=file
SESSION_LIFETIME=60
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

CACHE_STORE=file
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local

MAIL_MAILER=smtp
MAIL_HOST=127.0.0.1
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="panel@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# ---- the agent -------------------------------------------------------------
# `socket` on a real server. `sandbox` simulates the machine and is for
# evaluation only; the UI shows a banner when it is on.
ATLAS_AGENT_DRIVER=socket
ATLAS_AGENT_SOCKET=/run/atlas/agent.sock
ATLAS_AGENT_KEY=/etc/atlas/agent.secret
ATLAS_AGENT_TIMEOUT=30

# ---- licensing -------------------------------------------------------------
# The vendor's base URL and the Ed25519 public key(s) used to verify signed
# tokens offline, keyed by kid. Rotation means adding a second entry; old
# tokens keep verifying until they expire.
ATLAS_CENTRAL_URL=https://api.atlas.example
ATLAS_SERVER_ID=
ATLAS_LICENSE_KEYS={}
ATLAS_LICENSE_GRACE_DAYS=14

# ---- ports (illustrative defaults; the installer renders nginx to match) ----
ATLAS_WHM_PORT=2087
ATLAS_PANEL_PORT=2083
ATLAS_WEBMAIL_PORT=2096

# ---- optional modules ------------------------------------------------------
# Mail is off unless the MTA was installed. Off means the menus disappear.
ATLAS_MAIL_ENABLED=true
ATLAS_IMAP_HOST=127.0.0.1
ATLAS_IMAP_PORT=993
ATLAS_SMTP_HOST=127.0.0.1
ATLAS_SMTP_PORT=587

ATLAS_DNS_ENABLED=true
ATLAS_NAMESERVERS=ns1.example.com,ns2.example.com

ATLAS_BACKUP_DIR=/var/backups/atlas
ATLAS_HOME_ROOT=/home

# ---- PHP runtime ----------------------------------------------------------
# Minor versions of PHP-FPM this server runs, and the default for new accounts.
# The installer writes these from the distribution's own archive:
#   Ubuntu 22.04 -> 8.1     Ubuntu 24.04 -> 8.3
# The WHM service screen lists exactly these units, so a value that does not
# match the installed packages produces no restart button at all.
ATLAS_PHP_VERSIONS=8.3
ATLAS_PHP_DEFAULT=8.3
